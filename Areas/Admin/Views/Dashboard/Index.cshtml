@{
    ViewData["Title"] = "Dashboard";
}

<h1>Dashboard</h1>
<div class="stats">
    <div class="stat"><b>@ViewBag.Products</b><span>Total products</span></div>
    <div class="stat"><b>@ViewBag.ActiveProducts</b><span>Visible on website</span></div>
    <div class="stat"><b>@ViewBag.Categories</b><span>Categories</span></div>
    <div class="stat"><b>@ViewBag.Offers</b><span>Active offers</span></div>
</div>