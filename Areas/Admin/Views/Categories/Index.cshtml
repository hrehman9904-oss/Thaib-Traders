@model IEnumerable<Category>
@{
    ViewData["Title"] = "Categories";
}

<div class="bar">
    <h1>Categories</h1>
    <a class="btn btn-red" asp-action="Create">+ Add category</a>
</div>

<table class="table">
    <thead><tr><th>Name</th><th>Products</th><th></th></tr></thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Name</td>
                <td>@c.Products.Count</td>
                <td class="actions">
                    <a class="btn btn-out sm" asp-action="Edit" asp-route-id="@c.Id">Edit</a>
                    <form asp-action="Delete" asp-route-id="@c.Id" method="post"
                          onsubmit="return confirm('Delete this category?');">
                        <button type="submit" class="btn btn-danger sm">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>