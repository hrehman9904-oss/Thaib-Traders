@model LoginViewModel
@{
    ViewData["Title"] = "Admin Login";
}

<section class="section">
    <div class="auth-box">
        <h1 class="page-title">Admin Login</h1>
        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
            <div asp-validation-summary="ModelOnly" class="form-error"></div>

            <label asp-for="Email">Email</label>
            <input asp-for="Email" autocomplete="username" />
            <span asp-validation-for="Email" class="form-error"></span>

            <label asp-for="Password">Password</label>
            <input asp-for="Password" autocomplete="current-password" />
            <span asp-validation-for="Password" class="form-error"></span>

            <label class="check"><input asp-for="RememberMe" /> Remember me</label>

            <button type="submit" class="btn btn-red">Log in</button>
        </form>
    </div>
</section>