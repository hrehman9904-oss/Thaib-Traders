@model ProductListViewModel
@{
    ViewData["Title"] = "Products";
}

<section class="section">
    <div class="head"><span class="eyebrow">Our shelves</span><h1 class="page-title">All Products</h1></div>

    <form method="get" class="search">
        @if (Model.SelectedCategoryId.HasValue)
        {
            <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
        }
        <input type="search" name="q" value="@Model.Query" placeholder="Search products..." />
        <button class="btn btn-red" type="submit">Search</button>
    </form>

    <div class="chips">
        <a class="chip @(Model.SelectedCategoryId == null ? "active" : "")" asp-action="Index">All</a>
        @foreach (var c in Model.Categories)
        {
            <a class="chip @(Model.SelectedCategoryId == c.Id ? "active" : "")"
               asp-action="Index" asp-route-categoryId="@c.Id">@c.Name</a>
        }
    </div>

    @if (Model.Products.Any())
    {
        <div class="grid">
            @foreach (var p in Model.Products)
            {
                <partial name="_ProductCard" model="p" />
            }
        </div>
    }
    else
    {
        <p class="empty">No products found.</p>
    }
</section>